# Hosted Postgres connection URL; use the provider's pooled connection URL with TLS.
DATABASE_URL=
# Generate with: openssl rand -hex 32
RATE_LIMIT_SECRET=
PORT=3000
# Production website origin, used at build time for canonical URLs and sitemap.
SITE_URL=
# Optional PEM CA for a database using a private certificate authority.
DATABASE_CA_CERT=
# Explicit opt-in for a loopback-only development database; ignored in production.
ALLOW_INSECURE_LOCAL_DB=false
